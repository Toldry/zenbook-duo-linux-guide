#!/usr/bin/python3
"""Hide release-then-press chatter on a worn mouse button.

Grabs the physical mouse and re-emits its events through a virtual (uinput)
mouse. When a held button is released during a drag, the release is held
back for HOLD_MS; if the same button is pressed again inside that window,
both the release and the press are dropped, so the drag stays one continuous
press.

A press counts as a drag once the pointer has moved DRAG_DISTANCE counts or
the button has been held LONG_HOLD_MS. Quick clicks (short and still) are
passed on at once, so they are not delayed.

The evtest capture from the MX Vertical (2026-10-27) showed spurious
release->press gaps of 46-52 ms, each in the middle of a drag with the
pointer moving, so the default window is 70 ms.

Needs: sudo apt install python3-evdev
Usage: sudo mouse-debounce ["device name substring"] [hold_ms]
The defaults come from $MOUSE_DEBOUNCE_DEVICE and $MOUSE_DEBOUNCE_HOLD_MS,
or else "MX Vertical" and 70 ms. $MOUSE_DEBOUNCE_DRAG_DISTANCE (default 10
counts) and $MOUSE_DEBOUNCE_LONG_HOLD_MS (default 300) decide what is a
drag. See MOUSE-CHATTER.md.

Waits for the mouse to appear and re-attaches after Bluetooth reconnects.
Written against the python-evdev API; not yet run on real hardware.
"""
import os
import select
import sys
import time

import evdev
from evdev import ecodes

DEFAULT_DEVICE_NAME = "MX Vertical"
DEFAULT_HOLD_MS = 70
DEFAULT_DRAG_DISTANCE = 10
DEFAULT_LONG_HOLD_MS = 300
VIRTUAL_DEVICE_NAME = "debounced-mouse"
WATCHED_BUTTONS = {ecodes.BTN_LEFT}
RESCAN_INTERVAL_SECONDS = 2


def find_device(name_substring):
    for path in evdev.list_devices():
        device = evdev.InputDevice(path)
        is_match = (name_substring in device.name
                    and device.name != VIRTUAL_DEVICE_NAME
                    and ecodes.EV_REL in device.capabilities())
        if is_match:
            return device
        device.close()
    return None


class HeldButton:
    """A watched button that is down, as far as the virtual mouse knows."""

    def __init__(self, now):
        self.pressed_at = now
        self.distance_moved = 0
        self.release_deadline = None  # set while a release is held back


def forward_with_debounce(physical, settings):
    virtual = evdev.UInput.from_device(physical, name=VIRTUAL_DEVICE_NAME)
    physical.grab()  # stop the compositor from seeing the raw device
    held_buttons = {}  # button code -> HeldButton

    def is_drag(held, now):
        return (held.distance_moved >= settings["drag_distance"]
                or now - held.pressed_at >= settings["long_hold_seconds"])

    def flush_expired_releases(now):
        for button, held in list(held_buttons.items()):
            deadline = held.release_deadline
            if deadline is not None and now >= deadline:
                virtual.write(ecodes.EV_KEY, button, 0)
                virtual.syn()
                del held_buttons[button]

    def pending_deadlines():
        return [held.release_deadline for held in held_buttons.values()
                if held.release_deadline is not None]

    try:
        while True:
            deadlines = pending_deadlines()
            if deadlines:
                timeout = max(min(deadlines) - time.monotonic(), 0)
            else:
                timeout = None
            readable, _, _ = select.select([physical.fd], [], [], timeout)
            flush_expired_releases(time.monotonic())
            if not readable:
                continue
            for event in physical.read():
                now = time.monotonic()
                if event.type == ecodes.EV_REL and event.code in (
                        ecodes.REL_X, ecodes.REL_Y):
                    for held in held_buttons.values():
                        held.distance_moved += abs(event.value)
                is_watched_button = (event.type == ecodes.EV_KEY
                                     and event.code in WATCHED_BUTTONS)
                if is_watched_button and event.value == 1:
                    held = held_buttons.get(event.code)
                    if held is not None and held.release_deadline is not None:
                        held.release_deadline = None  # chatter: drop both
                        continue
                    held_buttons[event.code] = HeldButton(now)
                elif is_watched_button and event.value == 0:
                    held = held_buttons.get(event.code)
                    if held is not None and is_drag(held, now):
                        held.release_deadline = (
                            now + settings["hold_seconds"])
                        continue
                    held_buttons.pop(event.code, None)  # quick click
                virtual.write_event(event)
    finally:
        for button in held_buttons:
            virtual.write(ecodes.EV_KEY, button, 0)  # never leave it stuck
        virtual.syn()
        virtual.close()
        try:
            physical.ungrab()
        except OSError:
            pass  # device already gone


def setting(argv_index, env_name, default):
    if len(sys.argv) > argv_index:
        return sys.argv[argv_index]
    return os.environ.get(env_name, default)


def main():
    name_substring = setting(1, "MOUSE_DEBOUNCE_DEVICE", DEFAULT_DEVICE_NAME)
    hold_ms = int(setting(2, "MOUSE_DEBOUNCE_HOLD_MS", DEFAULT_HOLD_MS))
    settings = {
        "hold_seconds": hold_ms / 1000,
        "drag_distance": int(os.environ.get("MOUSE_DEBOUNCE_DRAG_DISTANCE",
                                            DEFAULT_DRAG_DISTANCE)),
        "long_hold_seconds": int(os.environ.get(
            "MOUSE_DEBOUNCE_LONG_HOLD_MS", DEFAULT_LONG_HOLD_MS)) / 1000,
    }
    while True:
        physical = find_device(name_substring)
        if physical is None:
            time.sleep(RESCAN_INTERVAL_SECONDS)
            continue
        print(f"debouncing {physical.name} ({physical.path}), {hold_ms} ms",
              flush=True)
        try:
            forward_with_debounce(physical, settings)
        except OSError:
            print("device disconnected, waiting for it", flush=True)
            time.sleep(RESCAN_INTERVAL_SECONDS)


if __name__ == "__main__":
    main()
