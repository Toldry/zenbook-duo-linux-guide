#!/usr/bin/env bash
# Reports how Windows wires Dolby's effects to the speakers, read from a
# mounted Windows partition: which APO GUIDs sit on each audio endpoint,
# which DLL implements each one, Dolby's registry keys, the bound sound
# drivers, the registry lines of the Dolby and ASUS/Realtek .inf files,
# the copies of the UX8406MA tuning XML, and Dolby's saved user settings.
#
# Read-only: nothing on the Windows partition is changed.
# Usage: sudo dolby-apo-report [WINDOWS_ROOT] > report.txt
#        WINDOWS_ROOT defaults to /run/media/$SUDO_USER/OS.
set -uo pipefail

windows_root=${1:-/run/media/${SUDO_USER:-$USER}/OS}
software_hive=$windows_root/Windows/System32/config/SOFTWARE
system_hive=$windows_root/Windows/System32/config/SYSTEM
driver_store=$windows_root/Windows/System32/DriverStore/FileRepository

if [[ $EUID -ne 0 ]]; then
    echo "Run it with sudo: the Windows driver folders are root-only." >&2
    exit 1
fi
if ! command -v hivexregedit > /dev/null; then
    echo "Missing hivexregedit. Install it first with:" >&2
    echo "    sudo apt install libwin-hivex-perl" >&2
    exit 1
fi
if [[ ! -f $software_hive ]]; then
    echo "No registry at $software_hive. Open the Windows partition in" >&2
    echo "Files first, or pass its mount point as the first argument." >&2
    exit 1
fi

work_dir=$(mktemp -d)
trap 'rm -r "$work_dir"' EXIT

# export_key HIVE PREFIX KEY: the key and its subkeys, in regedit format.
export_key() {
    hivexregedit --export --unsafe-printable-strings --prefix "$2" "$1" "$3"
}

# Rewrites REG_MULTI_SZ values (hex(7), UTF-16LE) as readable text,
# because the composite effect lists on an endpoint are stored that way.
decode_multi_strings() {
    perl -MEncode -pe '
        if (/^(".*")=hex\(7\):(.*)$/) {
            my ($name, $hex) = ($1, $2);
            $hex =~ s/,//g;
            my $text = decode("UTF-16LE", pack("H*", $hex));
            $text =~ s/\0+$//;
            $text =~ s/\0/ | /g;
            $_ = "$name=multi:\"$text\"\n";
        }'
}

section() { printf '\n######## %s\n' "$*"; }

guid_pattern='\{[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\}'

section "1. Audio endpoints: names and attached effects (FxProperties)"
export_key "$software_hive" 'HKEY_LOCAL_MACHINE\SOFTWARE' \
    '\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render' 2>&1 |
    decode_multi_strings > "$work_dir/render.reg"
# Binary blobs (icons, wave formats) are left out.
grep -v -E '=hex\(' "$work_dir/render.reg" | grep -v '^$'

section "2. Every APO registered with the audio engine"
export_key "$software_hive" 'HKEY_LOCAL_MACHINE\SOFTWARE' \
    '\Classes\AudioEngine\AudioProcessingObjects' > "$work_dir/apos.reg" 2>&1
grep -v '^$' "$work_dir/apos.reg"

section "3. The DLL behind each GUID in sections 1 and 2"
{
    sed -n 's/^"[^"]*"=//p' "$work_dir/render.reg"
    grep '^\[' "$work_dir/apos.reg"
} | grep -o -E "$guid_pattern" | sort -fu > "$work_dir/guids.txt"
while read -r guid; do
    class=$(export_key "$software_hive" 'HKEY_LOCAL_MACHINE\SOFTWARE' \
        "\\Classes\\CLSID\\$guid" 2> /dev/null)
    if [[ $class == *InprocServer32* ]]; then
        grep -v '^$' <<< "$class"
    fi
done < "$work_dir/guids.txt"

section "4. Dolby's registry keys"
export_key "$software_hive" 'HKEY_LOCAL_MACHINE\SOFTWARE' '\Dolby' 2>&1 |
    grep -v '^$' | head -300

section "5. Sound drivers bound in Windows (MEDIA device class)"
export_key "$system_hive" 'HKEY_LOCAL_MACHINE\SYSTEM' \
    '\ControlSet001\Control\Class\{4d36e96c-e325-11ce-bfc1-08002be10318}' \
    2>&1 | decode_multi_strings > "$work_dir/media.reg"
grep -E '^\[|"(DriverDesc|InfPath|InfSection|MatchingDeviceId|DriverVersion|ProviderName)"=' \
    "$work_dir/media.reg"
echo "-- Effect settings the driver .inf files wrote for each endpoint (EP and FX keys)"
awk '/^\[/ { on = ($0 ~ /\\(EP|FX)\\/) } on && !/=hex\(/' "$work_dir/media.reg" |
    grep -v '^$' | head -200

section "6. Registry lines in the Dolby and ASUS/Realtek .inf files"
for inf in "$driver_store"/dax3_swc_aposvc.inf_*/*.inf \
           "$driver_store"/hdx_asusext_dolby*/*.inf \
           "$driver_store"/dax3_ext_*/*.inf; do
    [[ -e $inf ]] || continue
    echo "== $inf"
    # Many .inf files are UTF-16; plain grep finds nothing in those.
    { iconv -f UTF-16 -t UTF-8 "$inf" 2> /dev/null || cat "$inf"; } |
        tr -d '\r' > "$work_dir/inf.txt"
    grep -n -i -E '^\s*HK(CR|LM|R)\s*,|ApoPreset|FX|AddReg|CLSID' \
        "$work_dir/inf.txt" | head -150
    echo "-- [Strings] entries with GUIDs or Dolby/APO/FX names"
    awk '/^\[/ { on = (tolower($0) ~ /^\[strings/); next } on' \
        "$work_dir/inf.txt" | grep -i -E "$guid_pattern|dolby|apo|fx" | head -80
done

section "7. Copies of the UX8406MA tuning XML (subsystem 1C43)"
for xml in "$driver_store"/dax3_ext_*/DEV_0294_SUBSYS_10431C43_*.xml; do
    [[ -e $xml ]] || continue
    echo "== $xml"
    grep -o -m 3 -E 'tuning_version="[^"]*"|<tuning_version>[^<]*' "$xml"
    sha256sum "$xml"
done

section "8. Dolby's saved user settings (ProgramData\\Dolby)"
ls -laR "$windows_root/ProgramData/Dolby" 2>&1 | head -60
for settings in "$windows_root"/ProgramData/Dolby/DAX3/*.xml; do
    [[ -e $settings ]] || continue
    echo "== $settings"
    grep -o -E '<[a-z_-]*(profile|enable|ieq|amount|preset|selected|endpoint)[a-z_-]*[^>]*>[^<]{0,120}' \
        "$settings" | head -100
done
